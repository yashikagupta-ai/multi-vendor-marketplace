<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Zell Admin Summary</title>
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2C2A; background: #F7F4EF; padding: 40px; }
        .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #E8D5C4; padding-bottom: 20px; }
        .header h1 { color: #C8DDD4; font-size: 32px; margin: 0; }
        .header p { color: #6E6C66; margin: 5px 0 0 0; }
        .summary { margin-bottom: 40px; }
        .summary-box { background: #FFFFFF; padding: 20px; border-radius: 8px; display: inline-block; width: 45%; margin-right: 2%; text-align: center; border: 1px solid rgba(44,44,42,0.10); }
        table { width: 100%; border-collapse: collapse; background: #FFFFFF; margin-bottom: 40px; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #E8D5C4; }
        th { background: #D4CAEC; color: #2C2C2A; font-weight: bold; }
        .footer { text-align: center; margin-top: 50px; font-size: 12px; color: #6E6C66; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Zell Marketplace</h1>
        <p>Admin Platform Commission Summary</p>
        <p>Generated: <%= new Date().toLocaleDateString() %></p>
    </div>

    <div class="summary">
        <div class="summary-box">
            <h3>Total Platform Gross</h3>
            <p>₹<%= totalGross %></p>
        </div>
        <div class="summary-box">
            <h3>Total Zell Commission</h3>
            <p>₹<%= totalZellCommission %></p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Vendor</th>
                <th>Tier</th>
                <th>Gross (₹)</th>
                <th>Commission (₹)</th>
            </tr>
        </thead>
        <tbody>
            <% vendors.forEach(function(vendor) { %>
            <tr>
                <td><%= vendor.storefront.name %></td>
                <td><%= vendor.tier %></td>
                <td><%= (vendor.gross / 100).toFixed(2) %></td>
                <td><%= (vendor.commission / 100).toFixed(2) %></td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <div class="footer">
        <p>Confidential Internal Report • Zell Marketplace</p>
    </div>
</body>
</html>
