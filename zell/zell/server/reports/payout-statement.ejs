<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Payout Statement</title>
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2C2A; background: #F7F4EF; padding: 40px; }
        .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #E8D5C4; padding-bottom: 20px; }
        .header h1 { color: #C8DDD4; font-size: 32px; margin: 0; }
        .header p { color: #6E6C66; margin: 5px 0 0 0; }
        .summary { margin-bottom: 40px; }
        .summary-box { background: #FFFFFF; padding: 20px; border-radius: 8px; display: inline-block; width: 30%; margin-right: 2%; text-align: center; border: 1px solid rgba(44,44,42,0.10); }
        table { width: 100%; border-collapse: collapse; background: #FFFFFF; }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #E8D5C4; }
        th { background: #D4CAEC; color: #2C2C2A; font-weight: bold; }
        .footer { text-align: center; margin-top: 50px; font-size: 12px; color: #6E6C66; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Zell Marketplace</h1>
        <p>Payout Statement: <%= vendorName %></p>
        <p>Period: <%= period %></p>
    </div>

    <div class="summary">
        <div class="summary-box">
            <h3>Gross Sales</h3>
            <p>₹<%= totalGross %></p>
        </div>
        <div class="summary-box">
            <h3>Zell Commission</h3>
            <p>₹<%= totalCommission %></p>
        </div>
        <div class="summary-box">
            <h3>Net Payout</h3>
            <p>₹<%= totalNet %></p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Gross (₹)</th>
                <th>Rate (%)</th>
                <th>Fee (₹)</th>
                <th>Net (₹)</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% entries.forEach(function(entry) { %>
            <tr>
                <td><%= entry.orderId %></td>
                <td><%= (entry.grossAmount / 100).toFixed(2) %></td>
                <td><%= entry.commissionRateApplied %>%</td>
                <td><%= (entry.commissionAmount / 100).toFixed(2) %></td>
                <td><%= (entry.netAmount / 100).toFixed(2) %></td>
                <td><%= entry.status %></td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <div class="footer">
        <p>Generated by Zell Marketplace • Multi-Vendor Platform</p>
    </div>
</body>
</html>
